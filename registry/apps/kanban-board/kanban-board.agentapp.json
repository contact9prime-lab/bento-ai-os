{
 "format": "agentos-app/1",
 "manifest": {
  "format": 1,
  "name": "Kanban Board",
  "icon": "",
  "description": "A three-column board for your tasks, with due dates, priorities and a limit on work in progress. Type a task in plain words and the AI fills in the details, or ask it to break a card into steps.",
  "version": "1",
  "permissions": [
   {
    "action": "app.data.read",
    "resource": "app:self/data",
    "reason": "load what you saved when the app opens",
    "required": true
   },
   {
    "action": "app.data.write",
    "resource": "app:self/data",
    "reason": "save what you add and change",
    "required": true
   },
   {
    "action": "tool.use",
    "resource": "tool:llm_generate*",
    "required": false,
    "reason": "read a task typed in plain words, and break a card into steps"
   },
   {
    "action": "agent.invoke",
    "resource": "agent:main",
    "required": false,
    "reason": "the ✦ assistant in the corner, which can act for you inside this app"
   }
  ],
  "prerequisites": {},
  "security": {
   "scanner": "static/1",
   "scanned_at": 1795803746,
   "verdict": "pass",
   "findings": []
  },
  "author": {
   "kind": "agent",
   "name": "Bento: written with an AI agent and checked by the Bento team"
  }
 },
 "html": "<style>\n  .kb-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:start}\n  .kb-col{background:color-mix(in srgb,var(--tx) 4%,transparent);border:1px solid var(--ln);border-radius:var(--rad);padding:10px;min-height:160px}\n  .kb-col.over{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 10%,transparent)}\n  .kb-col h2{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}\n  .kb-card{background:var(--s2);border:1px solid var(--ln);border-radius:11px;padding:9px 10px;margin-bottom:8px;cursor:grab}\n  .kb-card:focus-visible{outline:2px solid var(--acc)}\n  .kb-card.dragging{opacity:.45}\n  .kb-card .title{font-weight:620;overflow-wrap:anywhere}\n  .kb-card .meta{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:6px;font-size:11.5px;color:var(--mut)}\n  .kb-card .acts{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap}\n  .kb-card .acts button{padding:3px 7px}\n  .kb-card .acts svg,.kb-ic svg{width:13px;height:13px;vertical-align:-2px}\n  .kb-note{font-size:12.5px;color:var(--mut);margin-top:4px;white-space:pre-wrap;overflow-wrap:anywhere}\n  .kb-due.late{color:var(--errc)}\n  .kb-p-high{border-left:3px solid var(--errc)} .kb-p-med{border-left:3px solid var(--warnc)}\n  .kb-add input{font-size:13px}\n  .kb-edit .grid2{gap:8px}\n  .kb-w .row{gap:8px}\n  @media (max-width:720px){ .kb-cols{grid-template-columns:1fr} }\n</style>\n\n<div class=\"widget-only\">\n  <div class=\"kb-w\">\n    <h3>Board</h3>\n    <div class=\"row\"><div class=\"kpi\"><b id=\"w-todo\">0</b><span>to do</span></div>\n      <div class=\"kpi\"><b id=\"w-doing\">0</b><span>doing</span></div>\n      <div class=\"kpi\"><b id=\"w-done\">0</b><span>done</span></div></div>\n    <div class=\"muted\" id=\"w-now\" style=\"margin-top:6px\"></div>\n  </div>\n</div>\n\n<div class=\"desktop-only\">\n  <div class=\"hero\">\n    <div><h1>Kanban Board</h1><div class=\"muted\">To do, doing, done. Type a task the way you'd say it.</div></div>\n    <button onclick=\"$('quick').focus()\" id=\"new-btn\"></button>\n  </div>\n\n  <div class=\"card accent\">\n    <label for=\"quick\">Add a task in plain words</label>\n    <div class=\"row\">\n      <input id=\"quick\" maxlength=\"300\" placeholder=\"e.g. Send Sam the invoice by Friday, it's urgent\">\n      <button onclick=\"quickAdd()\" id=\"quick-btn\">Add</button>\n    </div>\n    <div class=\"muted\" id=\"quick-note\" style=\"margin-top:6px\">The AI reads the date and how urgent it is. Without AI the words become the title.</div>\n  </div>\n\n  <div class=\"row spread\" style=\"margin:4px 0 10px\">\n    <div class=\"row\">\n      <input id=\"find\" placeholder=\"Filter cards\" style=\"max-width:240px\">\n      <label class=\"toggle\"><input type=\"checkbox\" id=\"mine-late\"><span></span> Only overdue</label>\n    </div>\n    <div class=\"row\"><span class=\"muted\">Doing limit</span>\n      <select id=\"wip\" style=\"width:auto\"><option value=\"2\">2</option><option value=\"3\">3</option><option value=\"4\">4</option><option value=\"5\">5</option><option value=\"0\">none</option></select>\n      <button class=\"ghost sm\" onclick=\"clearDone()\" id=\"clear-btn\"></button>\n      <button class=\"ghost sm\" onclick=\"share()\" id=\"share-btn\"></button></div>\n  </div>\n\n  <div class=\"kb-cols\" id=\"board\"></div>\n\n  <div class=\"card\" style=\"margin-top:14px\">\n    <div class=\"spread\"><h2>What should I do next?</h2><button class=\"ghost sm\" onclick=\"whatNext()\" id=\"next-btn\"></button></div>\n    <div id=\"next\" class=\"kb-note\">Asks the AI to read the board, weigh what is overdue and urgent, and pick your next one or two cards.</div>\n  </div>\n</div>\n\n<script>\nconst COLS = [['todo', 'To do'], ['doing', 'Doing'], ['done', 'Done']];\nlet S = {cards: [], wip: 3}, editing = '', dragId = '';\nconst $ = id => document.getElementById(id);\nconst esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst uid = () => Math.random().toString(36).slice(2, 10);\nconst ymd = d => { d = new Date(d); return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };\nconst TODAY = () => ymd(new Date());\nconst late = c => c.due && c.col !== 'done' && c.due < TODAY();\n\nasync function save(){ await appData.set(S); }\n\nfunction dueWords(due){\n  if(!due) return '';\n  const d = new Date(due + 'T12:00'), days = Math.round((d - new Date(TODAY() + 'T12:00')) / 864e5);\n  if(days === 0) return 'due today';\n  if(days === 1) return 'due tomorrow';\n  if(days === -1) return 'was due yesterday';\n  if(days < 0) return 'was due ' + appFmt.date(d.getTime());\n  return 'due ' + (days < 7 ? d.toLocaleDateString(undefined, {weekday:'long'}) : appFmt.date(d.getTime()));\n}\n\nfunction cardHTML(c){\n  const i = COLS.findIndex(x => x[0] === c.col);\n  if(c.id === editing) return `<div class=\"kb-card kb-edit\" data-id=\"${c.id}\">\n      <label>Title</label><input id=\"e-title\" value=\"${esc(c.title)}\" maxlength=\"140\">\n      <label>Notes</label><textarea id=\"e-note\" rows=\"3\">${esc(c.note || '')}</textarea>\n      <div class=\"grid2\"><div><label>Due</label><input id=\"e-due\" type=\"date\" value=\"${esc(c.due || '')}\"></div>\n        <div><label>Priority</label><select id=\"e-pri\">${['low','med','high'].map(p => `<option value=\"${p}\" ${c.pri === p ? 'selected' : ''}>${{low:'Normal',med:'Soon',high:'Urgent'}[p]}</option>`).join('')}</select></div></div>\n      <div class=\"row\" style=\"margin-top:8px\"><button class=\"sm\" onclick=\"saveEdit('${c.id}')\">Save</button>\n        <button class=\"ghost sm\" onclick=\"editing='';paint()\">Cancel</button>\n        <button class=\"ghost sm danger\" onclick=\"remove('${c.id}')\">${appIcon('trash')} Delete</button></div></div>`;\n  return `<div class=\"kb-card ${c.pri === 'high' ? 'kb-p-high' : c.pri === 'med' ? 'kb-p-med' : ''}\" draggable=\"true\" tabindex=\"0\" data-id=\"${c.id}\">\n    <div class=\"title\">${esc(c.title)}</div>\n    ${c.note ? `<div class=\"kb-note\">${esc(c.note)}</div>` : ''}\n    <div class=\"meta\">${c.pri === 'high' ? '<span class=\"badge err\">urgent</span>' : c.pri === 'med' ? '<span class=\"badge warn\">soon</span>' : ''}\n      ${c.due ? `<span class=\"kb-due ${late(c) ? 'late' : ''}\">${esc(dueWords(c.due))}</span>` : ''}\n      ${c.from ? `<span>from “${esc(c.from)}”</span>` : ''}</div>\n    <div class=\"acts\">\n      ${i > 0 ? `<button class=\"ghost sm\" title=\"Move left\" onclick=\"move('${c.id}',-1)\">←</button>` : ''}\n      ${i < 2 ? `<button class=\"ghost sm\" title=\"Move right\" onclick=\"move('${c.id}',1)\">→</button>` : ''}\n      <button class=\"ghost sm\" title=\"Edit\" onclick=\"editing='${c.id}';paint()\">${appIcon('edit')}</button>\n      ${c.col !== 'done' ? `<button class=\"ghost sm\" title=\"Break into steps\" onclick=\"breakDown('${c.id}',this)\">${appIcon('sparkle')} Steps</button>` : ''}\n    </div></div>`;\n}\n\nfunction paint(){\n  const q = ($('find').value || '').toLowerCase(), onlyLate = $('mine-late').checked;\n  const show = c => (!q || (c.title + ' ' + (c.note || '')).toLowerCase().includes(q)) && (!onlyLate || late(c));\n  $('board').innerHTML = COLS.map(([k, label]) => {\n    const all = S.cards.filter(c => c.col === k), cards = all.filter(show);\n    const over = k === 'doing' && S.wip && all.length > S.wip;\n    return `<div class=\"kb-col\" data-col=\"${k}\">\n      <h2><span>${label} <span class=\"muted\">${all.length}</span></span>${over ? '<span class=\"badge warn\">over the limit</span>' : ''}</h2>\n      ${cards.map(cardHTML).join('') || `<div class=\"empty\">${k === 'todo' ? '<b>Nothing to do</b>Add a task above, or <a href=\"#\" onclick=\"example();return false\">try an example board</a>.'\n        : k === 'doing' ? 'Drag a card here when you start it.' : 'Finished cards land here.'}</div>`}\n      ${k === 'todo' ? `<div class=\"row kb-add\"><input placeholder=\"Quick card\" data-add=\"todo\" maxlength=\"140\"></div>` : ''}\n    </div>`; }).join('');\n  wire();\n  const n = k => S.cards.filter(c => c.col === k).length;\n  $('w-todo').textContent = n('todo'); $('w-doing').textContent = n('doing'); $('w-done').textContent = n('done');\n  const now = S.cards.find(c => c.col === 'doing') || S.cards.find(c => c.col === 'todo');\n  $('w-now').textContent = now ? (now.col === 'doing' ? 'Now: ' : 'Next: ') + now.title : 'The board is empty.';\n}\n\nfunction wire(){\n  document.querySelectorAll('.kb-card[draggable]').forEach(el => {\n    el.addEventListener('dragstart', e => { dragId = el.dataset.id; el.classList.add('dragging'); e.dataTransfer.setData('text/plain', dragId); });\n    el.addEventListener('dragend', () => el.classList.remove('dragging'));\n    el.addEventListener('keydown', e => {\n      if(e.key === 'ArrowRight') move(el.dataset.id, 1); if(e.key === 'ArrowLeft') move(el.dataset.id, -1);\n      if(e.key === 'Enter'){ editing = el.dataset.id; paint(); }\n    });\n  });\n  document.querySelectorAll('.kb-col').forEach(col => {\n    col.addEventListener('dragover', e => { e.preventDefault(); col.classList.add('over'); });\n    col.addEventListener('dragleave', () => col.classList.remove('over'));\n    col.addEventListener('drop', e => { e.preventDefault(); col.classList.remove('over');\n      const id = e.dataTransfer.getData('text/plain') || dragId; place(id, col.dataset.col); });\n  });\n  document.querySelectorAll('[data-add]').forEach(inp => inp.addEventListener('keydown', async e => {\n    if(e.key !== 'Enter' || !inp.value.trim()) return;\n    S.cards.push({id: uid(), title: inp.value.trim(), col: 'todo', pri: 'low', at: Date.now()});\n    paint(); await save(); const again = document.querySelector('[data-add]'); if(again) again.focus();\n  }));\n  if(editing){ const t = $('e-title'); if(t){ t.focus(); t.addEventListener('keydown', e => { if(e.key === 'Enter') saveEdit(editing); if(e.key === 'Escape'){ editing = ''; paint(); } }); } }\n}\n\nasync function place(id, col){\n  const c = S.cards.find(x => x.id === id); if(!c || c.col === col) return;\n  const wasDoneAll = S.cards.length && S.cards.every(x => x.col === 'done');\n  c.col = col; c.moved = Date.now();\n  S.cards = S.cards.filter(x => x !== c).concat(c);\n  if(col === 'doing' && S.wip && S.cards.filter(x => x.col === 'doing').length > S.wip)\n    appToast('That is more than ' + S.wip + ' things at once. Finishing one first is usually faster.', 'info');\n  if(col === 'done'){ appToast('Done: ' + c.title, 'ok');\n    if(!wasDoneAll && S.cards.every(x => x.col === 'done')) appCelebrate(); }\n  paint(); await save();\n}\nfunction move(id, dir){ const c = S.cards.find(x => x.id === id); if(!c) return;\n  const i = COLS.findIndex(x => x[0] === c.col) + dir; if(i < 0 || i > 2) return; place(id, COLS[i][0]); }\n\nasync function saveEdit(id){\n  const c = S.cards.find(x => x.id === id); if(!c) return;\n  const t = $('e-title').value.trim(); if(!t){ $('e-title').focus(); return; }\n  c.title = t; c.note = $('e-note').value.trim(); c.due = $('e-due').value || ''; c.pri = $('e-pri').value;\n  editing = ''; paint(); await save(); appToast('Saved', 'ok');\n}\nasync function remove(id){\n  const c = S.cards.find(x => x.id === id); if(!c) return;\n  if(!(await appConfirm('Delete \"' + c.title + '\"?', {danger: true, ok: 'Delete'}))) return;\n  S.cards = S.cards.filter(x => x.id !== id); editing = ''; paint(); await save();\n}\nasync function clearDone(){\n  const n = S.cards.filter(c => c.col === 'done').length;\n  if(!n){ appToast('Nothing in Done yet', 'info'); return; }\n  if(!(await appConfirm('Clear ' + n + ' finished card' + (n === 1 ? '' : 's') + '?', {ok: 'Clear'}))) return;\n  S.cards = S.cards.filter(c => c.col !== 'done'); paint(); await save();\n}\n\nfunction readJSON(text){\n  const m = String(text || '').match(/\\{[\\s\\S]*\\}|\\[[\\s\\S]*\\]/);\n  if(!m) return null;\n  try{ return JSON.parse(m[0]); }catch(e){ return null; }\n}\n\nasync function quickAdd(){\n  const words = $('quick').value.trim(); if(!words) return;\n  const btn = $('quick-btn'); btn.disabled = true; btn.innerHTML = '<span class=\"spin\"></span>';\n  const out = await appLLM('Today is ' + TODAY() + ' (' + new Date().toLocaleDateString(undefined, {weekday:'long'}) + '). Task: \"' + words + '\"',\n    'Turn the task into JSON only: {\"title\": short imperative title, \"due\": \"YYYY-MM-DD\" or \"\", \"priority\": \"low\"|\"med\"|\"high\", \"note\": \"\" or one line}. ' +\n    'A weekday means the next one. Urgent, asap or today means high.');\n  const got = out.startsWith('[error]') ? null : readJSON(out);\n  const card = {id: uid(), col: 'todo', at: Date.now(), title: words.slice(0, 140), pri: 'low', due: '', note: ''};\n  if(got && typeof got.title === 'string' && got.title.trim()){\n    card.title = got.title.trim().slice(0, 140);\n    card.due = /^\\d{4}-\\d{2}-\\d{2}$/.test(got.due || '') ? got.due : '';\n    card.pri = ['low', 'med', 'high'].includes(got.priority) ? got.priority : 'low';\n    card.note = typeof got.note === 'string' ? got.note.slice(0, 300) : '';\n    $('quick-note').textContent = 'Added \"' + card.title + '\"' + (card.due ? ', ' + dueWords(card.due) : '') + '.';\n  }else{\n    $('quick-note').innerHTML = out.startsWith('[error]') ? '<span class=\"err\">The AI is not available, so the words became the title.</span>' : 'Added as written.';\n  }\n  S.cards.push(card); $('quick').value = '';\n  btn.disabled = false; btn.textContent = 'Add';\n  paint(); await save();\n}\n\nasync function breakDown(id, btn){\n  const c = S.cards.find(x => x.id === id); if(!c) return;\n  btn.disabled = true; btn.innerHTML = '<span class=\"spin\"></span>';\n  const out = await appLLM('Task: \"' + c.title + '\"' + (c.note ? '\\nNotes: ' + c.note : ''),\n    'Break the task into 2 to 5 small next steps someone could each finish in under an hour. Reply with JSON only: [\"step\", \"step\"].');\n  const steps = out.startsWith('[error]') ? null : readJSON(out);\n  if(!Array.isArray(steps) || !steps.length){\n    btn.disabled = false; btn.innerHTML = appIcon('sparkle') + ' Steps';\n    appToast(out.startsWith('[error]') ? 'The AI is not available right now' : 'The AI did not give steps this time', 'err'); return;\n  }\n  steps.slice(0, 5).forEach(s => S.cards.push({id: uid(), col: 'todo', title: String(s).slice(0, 140), pri: c.pri, due: c.due, from: c.title, at: Date.now()}));\n  paint(); await save(); appToast('Added ' + Math.min(5, steps.length) + ' steps', 'ok');\n}\n\nasync function whatNext(){\n  const open = S.cards.filter(c => c.col !== 'done');\n  const box = $('next');\n  if(!open.length){ box.textContent = 'Nothing open. Add a task first.'; return; }\n  box.innerHTML = '<span class=\"spin\"></span>';\n  const list = open.map(c => `- [${c.col}] ${c.title}` + (c.due ? ` (${dueWords(c.due)})` : '') + (c.pri !== 'low' ? ` [${c.pri === 'high' ? 'urgent' : 'soon'}]` : '')).join('\\n');\n  const out = await appLLM.stream('Today is ' + TODAY() + '. My open cards:\\n' + list +\n    '\\n\\nPick the one or two I should do next and say why in a sentence each. If too much is in Doing, say which to finish first. Short.',\n    {system: 'You are a calm project lead. Be specific, use the card titles.', onDelta: (_, all) => { box.textContent = all; }});\n  if(out.startsWith('[error]')) box.innerHTML = '<span class=\"err\">The AI could not answer: ' + esc(out.slice(8)) + '</span>';\n}\n\nfunction share(){\n  const lines = COLS.map(([k, label]) => { const cs = S.cards.filter(c => c.col === k);\n    return label + ' (' + cs.length + ')\\n' + (cs.map(c => '• ' + c.title + (c.due ? ' (' + dueWords(c.due) + ')' : '')).join('\\n') || '• nothing'); });\n  appShare({title: 'My board', text: lines.join('\\n\\n')});\n}\n\nasync function example(){\n  const d = n => { const x = new Date(); x.setDate(x.getDate() + n); return ymd(x); };\n  S.cards = [\n    {title: 'Send Sam the March invoice', col: 'todo', pri: 'high', due: d(0)},\n    {title: 'Book the team offsite venue', col: 'todo', pri: 'med', due: d(4), note: 'Thirty people, somewhere near the station'},\n    {title: 'Draft the launch email', col: 'todo', pri: 'low', due: d(6)},\n    {title: 'Review the pricing page copy', col: 'doing', pri: 'med', due: d(1)},\n    {title: 'Fix the signup bug on mobile', col: 'doing', pri: 'high', due: d(-1)},\n    {title: 'Write up last week\\'s interview notes', col: 'done', pri: 'low'},\n  ].map(c => ({id: uid(), at: Date.now(), ...c}));\n  paint(); await save(); appToast('Here is an example board', 'ok');\n}\n\n$('new-btn').innerHTML = appIcon('plus') + ' New task';\n$('clear-btn').innerHTML = appIcon('check') + ' Clear done';\n$('share-btn').innerHTML = appIcon('share') + ' Share';\n$('next-btn').innerHTML = appIcon('sparkle') + ' Ask';\n$('quick').addEventListener('keydown', e => { if(e.key === 'Enter') quickAdd(); });\n$('find').addEventListener('input', paint);\n$('mine-late').addEventListener('change', paint);\n$('wip').addEventListener('change', async () => { S.wip = Number($('wip').value); paint(); await save(); });\n\n(async () => {\n  const got = await appData.get();\n  if(got && Array.isArray(got.cards)) S = Object.assign({wip: 3}, got);\n  $('wip').value = String(S.wip);\n  paint();\n  if(appSurface.desktop) $('quick').focus();\n  if(appSurface.desktop) appCopilot.mount({starters: ['What should I do next?', 'Move everything overdue to Doing', 'Which cards are due this week?']});\n})();\nwindow.addEventListener('appdata', async () => { const got = await appData.get(); if(got && Array.isArray(got.cards)){ S = Object.assign({wip: 3}, got); paint(); } });\n</script>\n",
 "checksum": "sha256:052a69d592f0561e049d775cc4c72e0ab9d3bd3f634e642e1942c9b524b79273",
 "signature": null
}
