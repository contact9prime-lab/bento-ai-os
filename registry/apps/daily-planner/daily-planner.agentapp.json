{
 "format": "agentos-app/1",
 "manifest": {
  "format": 1,
  "name": "Daily Planner",
  "icon": "",
  "description": "Plan today as time blocks around your top three priorities, see what's now and next, and carry unfinished priorities to tomorrow. The AI drafts the day's blocks for you to keep or change.",
  "version": "1",
  "permissions": [
   {
    "action": "app.data.read",
    "resource": "app:self/data",
    "reason": "load what you saved when the app opens",
    "required": true
   },
   {
    "action": "app.data.write",
    "resource": "app:self/data",
    "reason": "save what you add and change",
    "required": true
   },
   {
    "action": "tool.use",
    "resource": "tool:llm_generate*",
    "required": false,
    "reason": "draft a plan for your day from your priorities"
   },
   {
    "action": "agent.invoke",
    "resource": "agent:main",
    "required": false,
    "reason": "the ✦ assistant in the corner, which can act for you inside this app"
   }
  ],
  "prerequisites": {},
  "security": {
   "scanner": "static/1",
   "scanned_at": 1795803746,
   "verdict": "pass",
   "findings": []
  },
  "author": {
   "kind": "agent",
   "name": "Bento: written with an AI agent and checked by the Bento team"
  }
 },
 "html": "<style>\n  .dp-bar{display:flex;height:26px;border-radius:9px;overflow:hidden;background:color-mix(in srgb,var(--tx) 6%,transparent);margin:6px 0 4px}\n  .dp-bar span{display:block;height:100%;min-width:2px}\n  .dp-bar .k-focus{background:var(--acc)} .dp-bar .k-meet{background:color-mix(in srgb,var(--acc2) 75%,#38bdf8)}\n  .dp-bar .k-admin{background:color-mix(in srgb,var(--warnc) 80%,transparent)} .dp-bar .k-break{background:color-mix(in srgb,var(--okc) 70%,transparent)}\n  .dp-bar .free{background:transparent}\n  .dp-bar .nowmark{background:var(--tx);min-width:2px;max-width:2px}\n  .dp-hours{display:flex;justify-content:space-between;font-size:10.5px;color:var(--mut)}\n  .dp-key{display:flex;gap:12px;flex-wrap:wrap;font-size:11.5px;color:var(--mut);margin-top:6px}\n  .dp-key i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:4px;vertical-align:0}\n  .dp-blk{display:grid;grid-template-columns:150px minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px 10px;border-radius:11px;\n    border:1px solid var(--ln);margin-bottom:6px;background:var(--s)}\n  .dp-blk.now{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,var(--s))}\n  .dp-blk.past{opacity:.55}\n  .dp-blk .t{font-variant-numeric:tabular-nums;font-size:12.5px;color:var(--mut)}\n  .dp-blk .n{font-weight:620;overflow-wrap:anywhere}\n  .dp-blk button{padding:4px 8px}\n  .dp-blk svg,.dp-ic svg{width:14px;height:14px;vertical-align:-2px}\n  .dp-top{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;align-items:center;margin-bottom:6px}\n  .dp-top input[type=checkbox]{width:18px;height:18px}\n  .dp-top.done input[type=text]{text-decoration:line-through;opacity:.6}\n  .dp-draft{white-space:pre-wrap}\n  .dp-form{display:grid;grid-template-columns:150px 150px minmax(0,1fr) 130px auto;gap:6px;align-items:end}\n  .dp-w .n{font-weight:650}\n  @media (max-width:720px){ .dp-form{grid-template-columns:1fr 1fr} .dp-form .wide{grid-column:1/-1} .dp-blk{grid-template-columns:118px minmax(0,1fr)} .dp-blk .acts{grid-column:1/-1} }\n</style>\n\n<div class=\"widget-only\">\n  <div class=\"dp-w\">\n    <h3 id=\"w-day\">Today</h3>\n    <div class=\"muted\">Now</div><div class=\"n\" id=\"w-now\">Nothing planned</div>\n    <div class=\"muted\" style=\"margin-top:6px\">Next</div><div id=\"w-next\">Nothing after this</div>\n  </div>\n</div>\n\n<div class=\"desktop-only\">\n  <div class=\"hero\">\n    <div><h1>Daily Planner</h1><div class=\"muted\" id=\"sub\">Give today a shape: three priorities, then time for each.</div></div>\n    <button onclick=\"draft()\" id=\"draft-btn\"></button>\n  </div>\n\n  <div class=\"grid2\">\n    <div class=\"card accent\">\n      <h2>Today's top three</h2>\n      <div id=\"tops\"></div>\n      <p class=\"muted\" style=\"margin:6px 0 0\">If only these get done, today was a good day.</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"spread\"><h2>The day at a glance</h2><span class=\"muted\" id=\"free\"></span></div>\n      <div class=\"dp-bar\" id=\"bar\"></div>\n      <div class=\"dp-hours\" id=\"hours\"></div>\n      <div class=\"dp-key\"><span><i class=\"k-focus\" style=\"background:var(--acc)\"></i>focus</span>\n        <span><i style=\"background:color-mix(in srgb,var(--acc2) 75%,#38bdf8)\"></i>meeting</span>\n        <span><i style=\"background:color-mix(in srgb,var(--warnc) 80%,transparent)\"></i>admin</span>\n        <span><i style=\"background:color-mix(in srgb,var(--okc) 70%,transparent)\"></i>break</span></div>\n    </div>\n  </div>\n\n  <div class=\"card\" id=\"draft-card\" hidden>\n    <div class=\"spread\"><h2>A draft for today</h2>\n      <span class=\"row\"><button class=\"sm\" onclick=\"keepDraft()\" id=\"keep-btn\">Use this plan</button><button class=\"ghost sm\" onclick=\"dropDraft()\">Not this one</button></span></div>\n    <label for=\"constraints\">Anything fixed today? (optional)</label>\n    <div class=\"row\"><input id=\"constraints\" maxlength=\"300\" placeholder=\"e.g. Standup at 9:30, lunch with Sam at 1, leave by 5:30\">\n      <button class=\"ghost sm\" onclick=\"draft()\">Draft again</button></div>\n    <div id=\"draft\" class=\"list\" style=\"margin-top:10px\"></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"spread\"><h2>Time blocks</h2>\n      <span class=\"row\"><button class=\"ghost sm\" onclick=\"carry()\" id=\"carry-btn\"></button><button class=\"ghost sm\" onclick=\"share()\" id=\"share-btn\"></button></span></div>\n    <div class=\"dp-form\">\n      <div><label for=\"b-from\">From</label><input id=\"b-from\" type=\"time\" step=\"900\"></div>\n      <div><label for=\"b-to\">To</label><input id=\"b-to\" type=\"time\" step=\"900\"></div>\n      <div class=\"wide\"><label for=\"b-name\">What</label><input id=\"b-name\" maxlength=\"120\" placeholder=\"e.g. Write the proposal\"></div>\n      <div><label for=\"b-kind\">Kind</label><select id=\"b-kind\"><option value=\"focus\">Focus</option><option value=\"meet\">Meeting</option><option value=\"admin\">Admin</option><option value=\"break\">Break</option></select></div>\n      <div><button onclick=\"addBlock()\" id=\"add-btn\">Add</button></div>\n    </div>\n    <div id=\"blocks\" style=\"margin-top:12px\"></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"spread\"><h2>End of the day</h2><button class=\"ghost sm\" onclick=\"lookBack()\" id=\"look-btn\"></button></div>\n    <div id=\"look\" class=\"dp-draft muted\">At the end of the day, the AI reads what you planned and what you ticked off, and writes three lines for tomorrow.</div>\n  </div>\n</div>\n\n<script>\nconst DAY_START = 7 * 60, DAY_END = 21 * 60;\nconst KIND = {focus:'Focus', meet:'Meeting', admin:'Admin', break:'Break'};\nlet S = {days: {}}, pending = null;\nconst $ = id => document.getElementById(id);\nconst esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst uid = () => Math.random().toString(36).slice(2, 10);\nconst ymd = d => { d = new Date(d); return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };\nconst TODAY = () => ymd(new Date());\nconst mins = t => { const m = /^(\\d{1,2}):(\\d{2})$/.exec(t || ''); return m ? Number(m[1]) * 60 + Number(m[2]) : NaN; };\nconst hhmm = n => String(Math.floor(n / 60)).padStart(2, '0') + ':' + String(n % 60).padStart(2, '0');\nconst label = n => new Date(2000, 0, 1, Math.floor(n / 60), n % 60).toLocaleTimeString([], {hour:'numeric', minute:'2-digit'});\nconst nowMin = () => { const d = new Date(); return d.getHours() * 60 + d.getMinutes(); };\n\nfunction day(){ const k = TODAY(); if(!S.days[k]) S.days[k] = {tops: [{t:'',d:false},{t:'',d:false},{t:'',d:false}], blocks: []}; return S.days[k]; }\nasync function save(){\n  // keep two months of days\n  const keep = Object.keys(S.days).sort().slice(-60); const next = {}; keep.forEach(k => next[k] = S.days[k]); S.days = next;\n  await appData.set(S);\n}\n\nfunction paint(){\n  const D = day(), now = nowMin();\n  $('sub').textContent = new Date().toLocaleDateString(undefined, {weekday:'long', month:'long', day:'numeric'}) + '. Three priorities, then time for each.';\n  $('w-day').textContent = new Date().toLocaleDateString(undefined, {weekday:'long'});\n  // top three\n  $('tops').innerHTML = D.tops.map((p, i) => `<div class=\"dp-top ${p.d ? 'done' : ''}\">\n      <input type=\"checkbox\" ${p.d ? 'checked' : ''} ${p.t ? '' : 'disabled'} aria-label=\"done\" onchange=\"topDone(${i},this.checked)\">\n      <input type=\"text\" value=\"${esc(p.t)}\" maxlength=\"120\" placeholder=\"${['The one that matters most', 'Second', 'Third'][i]}\" onchange=\"topText(${i},this.value)\">\n      <button class=\"ghost sm\" title=\"Plan time for it\" onclick=\"planTop(${i})\" ${p.t ? '' : 'disabled'}>${appIcon('clock')}</button></div>`).join('');\n  // blocks\n  const bl = D.blocks.slice().sort((a, b) => a.from - b.from);\n  $('blocks').innerHTML = bl.length ? bl.map(b => { const st = now >= b.to ? 'past' : now >= b.from ? 'now' : '';\n    return `<div class=\"dp-blk ${st}\">\n      <span class=\"t\">${label(b.from)}–${label(b.to)}</span>\n      <div><div class=\"n\">${esc(b.name)}</div><div class=\"muted\">${KIND[b.kind] || ''}${st === 'now' ? ' · now, ' + (b.to - now) + ' min left' : ''}</div></div>\n      <span class=\"acts\"><button class=\"ghost sm\" title=\"Edit\" onclick=\"editBlock('${b.id}')\">${appIcon('edit')}</button>\n        <button class=\"ghost sm\" title=\"Remove\" onclick=\"dropBlock('${b.id}')\">${appIcon('x')}</button></span></div>`; }).join('')\n    : `<div class=\"empty\"><b>No time blocks yet</b>Add one above, or write your top three and press Draft my day.\n        <div class=\"row\" style=\"margin-top:8px;justify-content:center\"><button class=\"ghost sm\" onclick=\"example()\">Try it with an example</button></div></div>`;\n  // the bar\n  const segs = []; let at = DAY_START;\n  bl.forEach(b => { const f = Math.max(DAY_START, b.from), t = Math.min(DAY_END, b.to);\n    if(t <= at) return; if(f > at) segs.push({w: f - at, c: 'free'}); segs.push({w: t - Math.max(f, at), c: 'k-' + b.kind, n: b.name}); at = t; });\n  if(at < DAY_END) segs.push({w: DAY_END - at, c: 'free'});\n  // a thin line for now, inside whichever segment it falls in\n  const out = []; let pos = DAY_START;\n  segs.forEach(s => { if(now > pos && now < pos + s.w){ out.push({w: now - pos, c: s.c, n: s.n}, {w: 0, c: 'nowmark', n: 'now'}, {w: pos + s.w - now, c: s.c, n: s.n}); }\n    else out.push(s); pos += s.w; });\n  $('bar').innerHTML = out.map(s => `<span class=\"${s.c}\" style=\"flex:${s.w} 0 0\" title=\"${esc(s.n || 'free')}\"></span>`).join('');\n  $('hours').innerHTML = [7, 10, 13, 16, 19, 21].map(h => `<span>${label(h * 60)}</span>`).join('');\n  const used = bl.reduce((a, b) => a + Math.max(0, Math.min(DAY_END, b.to) - Math.max(DAY_START, b.from)), 0);\n  $('free').textContent = appFmt.num((DAY_END - DAY_START - used) / 60, 1) + ' h unplanned';\n  // widget\n  const cur = bl.find(b => now >= b.from && now < b.to), next = bl.find(b => b.from >= now && b !== cur);\n  $('w-now').textContent = cur ? cur.name + ', until ' + label(cur.to) : 'Nothing planned right now';\n  $('w-next').textContent = next ? label(next.from) + ' ' + next.name : 'Nothing after this';\n}\n\nasync function topText(i, v){ const D = day(); D.tops[i].t = v.trim(); if(!D.tops[i].t) D.tops[i].d = false; paint(); await save(); }\nasync function topDone(i, v){\n  const D = day(); D.tops[i].d = v; paint(); await save();\n  if(v && D.tops.filter(p => p.t).every(p => p.d)){ appCelebrate(); appToast('All three done. Good day.', 'ok'); }\n}\nfunction planTop(i){ const D = day(); $('b-name').value = D.tops[i].t; $('b-kind').value = 'focus';\n  const start = Math.max(DAY_START, Math.ceil(nowMin() / 15) * 15); $('b-from').value = hhmm(start); $('b-to').value = hhmm(Math.min(DAY_END, start + 90)); $('b-name').focus(); }\n\nasync function addBlock(){\n  const f = mins($('b-from').value), t = mins($('b-to').value), n = $('b-name').value.trim();\n  if(!n){ $('b-name').focus(); return; }\n  if(isNaN(f) || isNaN(t) || t <= f){ appToast('Pick a start and an end after it', 'err'); return; }\n  const D = day();\n  const clash = D.blocks.find(b => b.from < t && f < b.to);\n  if(clash && !(await appConfirm('That overlaps \"' + clash.name + '\". Add it anyway?'))) return;\n  D.blocks.push({id: uid(), from: f, to: t, name: n, kind: $('b-kind').value});\n  $('b-name').value = ''; $('b-from').value = hhmm(t); $('b-to').value = hhmm(Math.min(DAY_END, t + 60));\n  paint(); await save(); appToast('Added ' + n, 'ok');\n}\nfunction editBlock(id){ const b = day().blocks.find(x => x.id === id); if(!b) return;\n  $('b-from').value = hhmm(b.from); $('b-to').value = hhmm(b.to); $('b-name').value = b.name; $('b-kind').value = b.kind;\n  day().blocks = day().blocks.filter(x => x !== b); paint(); $('b-name').focus(); appToast('Change it and press Add', 'info'); }\nasync function dropBlock(id){ const D = day(); D.blocks = D.blocks.filter(b => b.id !== id); paint(); await save(); }\n\nasync function draft(){\n  const D = day(), tops = D.tops.map(p => p.t).filter(Boolean);\n  if(!tops.length){ appToast('Write at least one priority first', 'info'); document.querySelector('.dp-top input[type=text]').focus(); return; }\n  $('draft-card').hidden = false;\n  const box = $('draft'); box.innerHTML = '<div class=\"muted\"><span class=\"spin\"></span> Drafting your day…</div>';\n  const start = Math.max(DAY_START, Math.ceil(nowMin() / 15) * 15);\n  const out = await appLLM('Priorities, most important first:\\n' + tops.map((t, i) => (i + 1) + '. ' + t).join('\\n') +\n    '\\nFixed things today: ' + ($('constraints').value.trim() || 'none') +\n    '\\nAlready planned: ' + (D.blocks.map(b => hhmm(b.from) + '-' + hhmm(b.to) + ' ' + b.name).join('; ') || 'nothing') +\n    '\\nPlan from ' + hhmm(start) + ' to ' + hhmm(Math.min(DAY_END, Math.max(start + 120, 18 * 60))) + '.',\n    'You plan a realistic workday. Put the hardest priority in the first long block, add a lunch break and short breaks, keep fixed things where they are, ' +\n    'and do not repeat what is already planned. Reply with JSON only: [{\"from\":\"HH:MM\",\"to\":\"HH:MM\",\"name\":\"...\",\"kind\":\"focus|meet|admin|break\"}].');\n  if(out.startsWith('[error]')){ box.innerHTML = '<div class=\"err\">The AI could not draft a plan: ' + esc(out.slice(8)) + '</div>'; return; }\n  let got = null; const j = out.match(/\\[[\\s\\S]*\\]/); try{ got = j ? JSON.parse(j[0]) : null; }catch(e){}\n  pending = Array.isArray(got) ? got.map(b => ({id: uid(), from: mins(b.from), to: mins(b.to), name: String(b.name || '').slice(0, 120),\n    kind: KIND[b.kind] ? b.kind : 'focus'})).filter(b => !isNaN(b.from) && !isNaN(b.to) && b.to > b.from && b.name).slice(0, 16) : null;\n  if(!pending || !pending.length){ box.innerHTML = '<div class=\"err\">The AI did not give a usable plan this time. Try Draft again.</div>'; pending = null; return; }\n  box.innerHTML = pending.map(b => `<div class=\"item\"><span class=\"dp-ic\">${appIcon(b.kind === 'break' ? 'heart' : b.kind === 'meet' ? 'user' : 'clock')}</span>\n    <div class=\"grow\"><div class=\"title\">${esc(b.name)}</div><div class=\"muted\">${label(b.from)}–${label(b.to)} · ${KIND[b.kind]}</div></div></div>`).join('');\n}\nasync function keepDraft(){\n  if(!pending) return; const D = day(); D.blocks = D.blocks.concat(pending); pending = null;\n  $('draft-card').hidden = true; paint(); await save(); appToast('Plan added to today', 'ok');\n}\nfunction dropDraft(){ pending = null; $('draft-card').hidden = true; }\n\nasync function carry(){\n  const D = day(), left = D.tops.filter(p => p.t && !p.d);\n  if(!left.length){ appToast('Nothing unfinished to carry over', 'info'); return; }\n  const t = new Date(); t.setDate(t.getDate() + 1); const k = ymd(t);\n  const T = S.days[k] || (S.days[k] = {tops: [{t:'',d:false},{t:'',d:false},{t:'',d:false}], blocks: []});\n  let n = 0;\n  left.forEach(p => { const slot = T.tops.find(x => !x.t); if(slot && !T.tops.some(x => x.t === p.t)){ slot.t = p.t; n++; } });\n  await save(); appToast(n ? 'Carried ' + n + ' to tomorrow' : 'Tomorrow is already full', n ? 'ok' : 'info');\n}\n\nasync function lookBack(){\n  const D = day(), box = $('look');\n  if(!D.blocks.length && !D.tops.some(p => p.t)){ box.textContent = 'Plan something first, then look back on it later.'; return; }\n  box.classList.remove('muted'); box.innerHTML = '<span class=\"spin\"></span>';\n  const out = await appLLM.stream('Top three today: ' + (D.tops.filter(p => p.t).map(p => p.t + (p.d ? ' (done)' : ' (not done)')).join('; ') || 'none') +\n    '\\nTime blocks: ' + (D.blocks.slice().sort((a, b) => a.from - b.from).map(b => hhmm(b.from) + '-' + hhmm(b.to) + ' ' + b.name).join('; ') || 'none') +\n    '\\nIn three short lines: what went well, what slipped and why it might have, and the one thing to put first tomorrow.',\n    {system: 'You are a kind, practical planner. No headings.', onDelta: (_, all) => { box.textContent = all; }});\n  if(out.startsWith('[error]')) box.innerHTML = '<span class=\"err\">The AI could not answer: ' + esc(out.slice(8)) + '</span>';\n}\n\nfunction share(){\n  const D = day(), bl = D.blocks.slice().sort((a, b) => a.from - b.from);\n  appShare({title: 'My plan for ' + new Date().toLocaleDateString(undefined, {weekday:'long'}),\n    text: (D.tops.filter(p => p.t).length ? 'Top three:\\n' + D.tops.filter(p => p.t).map((p, i) => (i + 1) + '. ' + p.t + (p.d ? ' (done)' : '')).join('\\n') + '\\n\\n' : '') +\n      (bl.map(b => label(b.from) + '–' + label(b.to) + '  ' + b.name).join('\\n') || 'No blocks yet.')});\n}\n\nasync function example(){\n  const D = day();\n  D.tops = [{t: 'Finish the proposal draft', d: false}, {t: 'Reply to the three client emails', d: false}, {t: 'Plan next week\\'s sprint', d: false}];\n  D.blocks = [[540, 570, 'Standup', 'meet'], [570, 690, 'Finish the proposal draft', 'focus'], [690, 705, 'Walk', 'break'],\n    [705, 750, 'Client emails', 'admin'], [750, 810, 'Lunch', 'break'], [810, 900, 'Sprint planning', 'meet'], [915, 1005, 'Proposal: tidy and send', 'focus']]\n    .map(([from, to, name, kind]) => ({id: uid(), from, to, name, kind}));\n  paint(); await save(); appToast('Here is an example day', 'ok');\n}\n\n$('draft-btn').innerHTML = appIcon('sparkle') + ' Draft my day';\n$('carry-btn').innerHTML = appIcon('calendar') + ' Carry to tomorrow';\n$('share-btn').innerHTML = appIcon('share') + ' Share';\n$('look-btn').innerHTML = appIcon('sparkle') + ' Look back on today';\n$('b-name').addEventListener('keydown', e => { if(e.key === 'Enter') addBlock(); });\n(() => { const s = Math.max(DAY_START, Math.ceil(nowMin() / 15) * 15); $('b-from').value = hhmm(Math.min(s, DAY_END - 60)); $('b-to').value = hhmm(Math.min(DAY_END, s + 60)); })();\n\n(async () => {\n  const got = await appData.get();\n  if(got && got.days && typeof got.days === 'object') S = got;\n  paint();\n  if(appSurface.desktop) appCopilot.mount({starters: ['What is next on my plan?', 'Move my afternoon focus block to 4pm', 'How much free time do I have today?']});\n})();\nwindow.addEventListener('appdata', async () => { const got = await appData.get(); if(got && got.days){ S = got; paint(); } });\nsetInterval(paint, 60000);\n</script>\n",
 "checksum": "sha256:3652b5cfb8cfa6331ca1a3bf9163a183b9d254d1943340aaf62453a0ec0d97a1",
