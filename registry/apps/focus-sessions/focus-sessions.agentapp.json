{
 "format": "agentos-app/1",
 "manifest": {
  "format": 1,
  "name": "Focus Sessions",
  "icon": "",
  "description": "A focus timer with short and long breaks, a daily goal, a streak and a chart of your week. The AI plans a session's steps and looks back on where your time went.",
  "version": "1",
  "permissions": [
   {
    "action": "app.data.read",
    "resource": "app:self/data",
    "reason": "load what you saved when the app opens",
    "required": true
   },
   {
    "action": "app.data.write",
    "resource": "app:self/data",
    "reason": "save what you add and change",
    "required": true
   },
   {
    "action": "tool.use",
    "resource": "tool:llm_generate*",
    "required": false,
    "reason": "plan a session's steps and look back on your week"
   },
   {
    "action": "tool.use",
    "resource": "tool:notify*",
    "required": false,
    "reason": "a desktop notification when a session or break ends"
   },
   {
    "action": "agent.invoke",
    "resource": "agent:main",
    "required": false,
    "reason": "the ✦ assistant in the corner, which can act for you inside this app"
   }
  ],
  "prerequisites": {},
  "security": {
   "scanner": "static/1",
   "scanned_at": 1795804285,
   "verdict": "pass",
   "findings": []
  },
  "author": {
   "kind": "agent",
   "name": "Bento: written with an AI agent and checked by the Bento team"
  }
 },
 "html": "<style>\n  .ft-clock{display:grid;place-items:center;margin:6px auto 4px;width:min(260px,70vw);aspect-ratio:1;border-radius:50%;\n    background:conic-gradient(var(--acc) calc(var(--p,0)*1turn),color-mix(in srgb,var(--tx) 9%,transparent) 0)}\n  .ft-face{width:86%;aspect-ratio:1;border-radius:50%;background:var(--bg2);display:grid;place-items:center;text-align:center}\n  .ft-time{font:780 clamp(40px,11vw,58px)/1 Inter,system-ui,sans-serif;letter-spacing:-.03em;font-variant-numeric:tabular-nums}\n  .ft-mode{color:var(--mut);font-size:12.5px;margin-top:6px}\n  .ft-ctl{justify-content:center;flex-wrap:wrap}\n  .ft-ctl button svg,.ft-ic svg{width:16px;height:16px;vertical-align:-3px;margin-right:4px}\n  .ft-week{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;align-items:end;height:120px}\n  .ft-bar{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:4px;height:100%;font-size:11px;color:var(--mut)}\n  .ft-bar i{display:block;width:100%;max-width:34px;border-radius:6px 6px 3px 3px;background:color-mix(in srgb,var(--acc) 70%,transparent);min-height:3px}\n  .ft-bar.today i{background:var(--acc)}\n  .ft-plan{white-space:pre-wrap;line-height:1.6}\n  .ft-w{display:flex;flex-direction:column;gap:6px}\n  .ft-w .ft-time{font-size:34px}\n  html.agentos-widget-s .ft-w .ft-time{font-size:30px}\n</style>\n\n<div class=\"widget-only\">\n  <div class=\"ft-w\">\n    <h3 id=\"w-mode\">Focus</h3>\n    <div class=\"ft-time\" id=\"w-time\">25:00</div>\n    <div class=\"muted\" id=\"w-today\">0 min focused today</div>\n    <div class=\"row\"><button class=\"sm\" id=\"w-go\" onclick=\"toggle()\">Start</button></div>\n  </div>\n</div>\n\n<div class=\"desktop-only\">\n  <div class=\"hero\">\n    <div><h1>Focus Sessions</h1><div class=\"muted\">Work in short, calm sessions and see where your time went.</div></div>\n    <button id=\"go\" onclick=\"toggle()\">Start focusing</button>\n  </div>\n\n  <div class=\"grid2\">\n    <div class=\"card accent\">\n      <div class=\"tabs\" id=\"modes\">\n        <button data-m=\"focus\" class=\"on\">Focus</button>\n        <button data-m=\"short\">Short break</button>\n        <button data-m=\"long\">Long break</button>\n      </div>\n      <div class=\"ft-clock\" id=\"clock\"><div class=\"ft-face\"><div>\n        <div class=\"ft-time\" id=\"time\">25:00</div>\n        <div class=\"ft-mode\" id=\"mode-label\">Focus · session 1</div>\n      </div></div></div>\n      <label for=\"task\">What are you working on?</label>\n      <div class=\"row\">\n        <input id=\"task\" placeholder=\"e.g. Draft the quarterly update\" maxlength=\"120\">\n      </div>\n      <div class=\"row ft-ctl\" style=\"margin-top:10px\">\n        <button class=\"ghost\" onclick=\"reset()\" id=\"reset\"></button>\n        <button class=\"ghost\" onclick=\"skip()\" id=\"skip\">Skip</button>\n        <button class=\"ghost\" onclick=\"planIt()\" id=\"plan-btn\"></button>\n      </div>\n      <div id=\"plan-box\" class=\"card\" style=\"margin-top:12px\" hidden>\n        <h3>A plan for this session</h3>\n        <div id=\"plan\" class=\"ft-plan\"></div>\n      </div>\n    </div>\n\n    <div>\n      <div class=\"cols\">\n        <div class=\"kpi\"><b id=\"k-min\">0</b><span>minutes today</span></div>\n        <div class=\"kpi\"><b id=\"k-ses\">0</b><span>sessions today</span></div>\n        <div class=\"kpi\"><b id=\"k-streak\">0</b><span>day streak</span></div>\n      </div>\n      <div class=\"card\" style=\"margin-top:12px\">\n        <div class=\"spread\"><h2>This week</h2><span class=\"muted\" id=\"goal-note\"></span></div>\n        <div class=\"ft-week\" id=\"week\"></div>\n      </div>\n      <div class=\"card\">\n        <div class=\"spread\"><h2>Today's sessions</h2>\n          <span class=\"row\"><button class=\"ghost sm\" onclick=\"review()\" id=\"review-btn\"></button>\n          <button class=\"ghost sm\" onclick=\"shareDay()\" id=\"share-btn\"></button></span></div>\n        <div id=\"review-box\" class=\"ft-plan\" hidden></div>\n        <div class=\"list\" id=\"log\"></div>\n      </div>\n    </div>\n  </div>\n\n  <details class=\"card\">\n    <summary><b>Settings</b> <span class=\"muted\">session lengths and your daily goal</span></summary>\n    <div class=\"cols\" style=\"margin-top:10px\">\n      <div><label for=\"s-focus\">Focus (minutes)</label><input id=\"s-focus\" type=\"number\" min=\"5\" max=\"120\"></div>\n      <div><label for=\"s-short\">Short break</label><input id=\"s-short\" type=\"number\" min=\"1\" max=\"30\"></div>\n      <div><label for=\"s-long\">Long break</label><input id=\"s-long\" type=\"number\" min=\"5\" max=\"60\"></div>\n      <div><label for=\"s-goal\">Daily goal (minutes)</label><input id=\"s-goal\" type=\"number\" min=\"15\" max=\"720\"></div>\n    </div>\n    <div class=\"row\" style=\"margin-top:10px\">\n      <label class=\"toggle\"><input type=\"checkbox\" id=\"s-auto\"><span></span> Start the break on its own</label>\n      <label class=\"toggle\"><input type=\"checkbox\" id=\"s-notify\"><span></span> Desktop notification at the end</label>\n    </div>\n    <div class=\"row\" style=\"margin-top:10px\"><button class=\"ghost sm\" onclick=\"saveSettings()\">Save settings</button>\n      <button class=\"ghost sm danger\" onclick=\"clearLog()\">Clear the history</button></div>\n  </details>\n</div>\n\n<script>\nconst MODES = {focus:'Focus', short:'Short break', long:'Long break'};\nconst DEF = {settings:{focus:25, short:5, long:15, goal:120, auto:false, notify:true},\n             sessions:[], run:null, mode:'focus', round:0};\nlet S = JSON.parse(JSON.stringify(DEF)), tick = 0;\n\nconst $ = id => document.getElementById(id);\nconst esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst ymd = d => { d = new Date(d); return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };\nconst today = () => ymd(Date.now());\n\nasync function save(){ await appData.set(S); }\nfunction lengthOf(m){ return Math.max(1, Number(S.settings[m] || DEF.settings[m])) * 60; }\nfunction left(){\n  if(!S.run) return S.paused != null ? S.paused : lengthOf(S.mode);\n  return Math.max(0, Math.round((S.run.ends - Date.now()) / 1000));\n}\n\nfunction paint(){\n  const l = left(), total = lengthOf(S.mode), t = appFmt.dur(l);\n  $('time').textContent = t; $('w-time').textContent = t;\n  $('clock').style.setProperty('--p', String(1 - l / total));\n  const label = MODES[S.mode] + (S.mode === 'focus' ? ' · session ' + (S.round + 1) : '');\n  $('mode-label').textContent = label; $('w-mode').textContent = MODES[S.mode];\n  const running = !!S.run;\n  $('go').innerHTML = appIcon(running ? 'pause' : 'play') + ' ' + (running ? 'Pause' : (S.paused != null ? 'Carry on' : 'Start ' + MODES[S.mode].toLowerCase()));\n  $('w-go').textContent = running ? 'Pause' : 'Start';\n  document.querySelectorAll('#modes button').forEach(b => b.classList.toggle('on', b.dataset.m === S.mode));\n  document.title = (running ? t + ' · ' : '') + 'Focus Sessions';\n}\n\nfunction stats(){\n  const day = today(), todays = S.sessions.filter(s => ymd(s.at) === day);\n  const mins = todays.reduce((a, s) => a + s.mins, 0);\n  $('k-min').textContent = appFmt.num(mins, 0); $('k-ses').textContent = todays.length;\n  $('w-today').textContent = appFmt.num(mins, 0) + ' of ' + S.settings.goal + ' min focused today';\n  // streak: days in a row, ending today or yesterday, with any focus\n  const days = new Set(S.sessions.map(s => ymd(s.at)));\n  let streak = 0, d = new Date();\n  if(!days.has(ymd(d))) d.setDate(d.getDate() - 1);\n  while(days.has(ymd(d))){ streak++; d.setDate(d.getDate() - 1); }\n  $('k-streak').textContent = streak;\n  $('goal-note').textContent = mins >= S.settings.goal ? 'goal met today' : (S.settings.goal - mins) + ' min to today\\'s goal';\n  // the week\n  const week = [];\n  for(let i = 6; i >= 0; i--){ const x = new Date(); x.setDate(x.getDate() - i);\n    const k = ymd(x); week.push({k, label: x.toLocaleDateString(undefined, {weekday:'short'}),\n      mins: S.sessions.filter(s => ymd(s.at) === k).reduce((a, s) => a + s.mins, 0)}); }\n  const top = Math.max(S.settings.goal, ...week.map(w => w.mins));\n  $('week').innerHTML = week.map(w => `<div class=\"ft-bar ${w.k === day ? 'today' : ''}\" title=\"${w.mins} min\">\n      <span>${w.mins || ''}</span><i style=\"height:${Math.round(w.mins / top * 100)}%\"></i><span>${esc(w.label)}</span></div>`).join('');\n  // the log\n  $('log').innerHTML = todays.length ? todays.slice().reverse().map(s => `<div class=\"item\">\n      <span class=\"ft-ic\">${appIcon('check')}</span>\n      <div class=\"grow\"><div class=\"title\">${esc(s.task || 'Focus session')}</div>\n        <div class=\"muted\">${s.mins} min · ${new Date(s.at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</div></div></div>`).join('')\n    : `<div class=\"empty\"><b>No sessions yet today</b>Name what you're working on and press Start. A session is ${S.settings.focus} minutes.\n        <div class=\"row\" style=\"margin-top:8px;justify-content:center\"><button class=\"ghost sm\" onclick=\"example()\">Try it with an example</button></div></div>`;\n}\n\nfunction startTick(){\n  clearInterval(tick);\n  tick = setInterval(() => { paint(); if(S.run && left() <= 0) finish(); }, 500);\n}\n\nasync function toggle(){\n  if(S.run){                                 // pause\n    S.paused = left(); S.run = null;\n  }else{                                     // start or carry on\n    const l = S.paused != null ? S.paused : lengthOf(S.mode);\n    S.run = {ends: Date.now() + l * 1000, task: $('task').value.trim()};\n    S.paused = null;\n  }\n  paint(); startTick(); await save();\n}\n\nasync function reset(){ S.run = null; S.paused = null; paint(); await save(); }\n\nasync function finish(){\n  const was = S.mode, task = (S.run && S.run.task) || $('task').value.trim();\n  S.run = null; S.paused = null;\n  if(was === 'focus'){\n    const before = todayMinutes();\n    S.sessions.push({task, mins: Number(S.settings.focus), at: Date.now()});\n    if(S.sessions.length > 2000) S.sessions = S.sessions.slice(-2000);\n    S.round++;\n    S.mode = S.round % 4 === 0 ? 'long' : 'short';\n    appToast('Session done. Time for a ' + MODES[S.mode].toLowerCase() + '.', 'ok');\n    if(before < S.settings.goal && todayMinutes() >= S.settings.goal){ appCelebrate(); appToast('Daily goal reached', 'ok'); }\n  }else{\n    S.mode = 'focus';\n    appToast('Break over. Ready when you are.', 'info');\n  }\n  if(S.settings.notify){\n    try{ await appTool('notify', {title: 'Focus Sessions', message: was === 'focus' ? 'Session done: take a break.' : 'Break over: back to it.'}); }catch(e){}\n  }\n  if(S.settings.auto && was === 'focus') S.run = {ends: Date.now() + lengthOf(S.mode) * 1000, task: ''};\n  paint(); stats(); await save();\n}\n\nasync function skip(){\n  if(!(await appConfirm('Skip to the next part without counting this one?'))) return;\n  S.run = null; S.paused = null;\n  S.mode = S.mode === 'focus' ? 'short' : 'focus';\n  paint(); await save();\n}\n\nfunction todayMinutes(){ const d = today(); return S.sessions.filter(s => ymd(s.at) === d).reduce((a, s) => a + s.mins, 0); }\n\nasync function setMode(m){\n  if(S.run && !(await appConfirm('A session is running. Switch anyway?'))) return;\n  S.mode = m; S.run = null; S.paused = null; paint(); await save();\n}\n\nasync function planIt(){\n  const task = $('task').value.trim();\n  if(!task){ appToast('Say what you are working on first', 'info'); $('task').focus(); return; }\n  $('plan-box').hidden = false;\n  const box = $('plan'); box.innerHTML = '<span class=\"spin\"></span>';\n  const out = await appLLM.stream(\n    `I have one ${S.settings.focus}-minute focus session for: \"${task}\". Give me three small, concrete steps that fit in it, ` +\n    `as a numbered list with roughly how many minutes each, then one line on what \"done\" looks like. No preamble.`,\n    {system: 'You are a calm, practical focus coach. Short sentences.', onDelta: (_, all) => { box.textContent = all; }});\n  if(out.startsWith('[error]')) box.innerHTML = '<span class=\"err\">The AI could not answer: ' + esc(out.slice(8)) + '</span>';\n}\n\nasync function review(){\n  const box = $('review-box'); box.hidden = false;\n  const week = S.sessions.filter(s => s.at > Date.now() - 7 * 864e5);\n  if(!week.length){ box.textContent = 'Nothing to look back on yet: finish a session first.'; return; }\n  box.innerHTML = '<span class=\"spin\"></span>';\n  const lines = week.map(s => ymd(s.at) + ' ' + s.mins + 'min ' + (s.task || '(untitled)')).join('\\n');\n  const out = await appLLM.stream('Here are my focus sessions from the last 7 days:\\n' + lines +\n    `\\nMy daily goal is ${S.settings.goal} minutes. In four short bullet points: where my time went, my best day, ` +\n    'a pattern you notice, and one suggestion for tomorrow.', {onDelta: (_, all) => { box.textContent = all; }});\n  if(out.startsWith('[error]')) box.innerHTML = '<span class=\"err\">The AI could not answer: ' + esc(out.slice(8)) + '</span>';\n}\n\nfunction shareDay(){\n  const d = today(), todays = S.sessions.filter(s => ymd(s.at) === d);\n  if(!todays.length){ appToast('No sessions to share yet today', 'info'); return; }\n  const by = {};\n  todays.forEach(s => { const k = s.task || 'Focus'; by[k] = (by[k] || 0) + s.mins; });\n  appShare({title: 'Focus today: ' + todayMinutes() + ' minutes in ' + todays.length + ' sessions',\n            text: Object.entries(by).map(([k, v]) => '• ' + k + ': ' + v + ' min').join('\\n')});\n}\n\nasync function saveSettings(){\n  const n = (id, lo, hi, d) => { const v = parseInt($(id).value, 10); return isNaN(v) ? d : Math.min(hi, Math.max(lo, v)); };\n  S.settings = {focus: n('s-focus', 5, 120, 25), short: n('s-short', 1, 30, 5), long: n('s-long', 5, 60, 15),\n                goal: n('s-goal', 15, 720, 120), auto: $('s-auto').checked, notify: $('s-notify').checked};\n  if(!S.run) S.paused = null;\n  paint(); stats(); await save(); appToast('Settings saved', 'ok');\n}\n\nfunction fillSettings(){\n  $('s-focus').value = S.settings.focus; $('s-short').value = S.settings.short; $('s-long').value = S.settings.long;\n  $('s-goal').value = S.settings.goal; $('s-auto').checked = !!S.settings.auto; $('s-notify').checked = S.settings.notify !== false;\n}\n\nasync function clearLog(){\n  if(!(await appConfirm('Delete every recorded session? This can\\'t be undone.', {danger: true, ok: 'Delete'}))) return;\n  S.sessions = []; S.round = 0; stats(); await save(); appToast('History cleared', 'ok');\n}\n\nasync function example(){\n  const tasks = ['Draft the quarterly update', 'Inbox to zero', 'Review the design doc', 'Write tests for checkout', 'Plan next week'];\n  const now = Date.now();\n  for(let day = 6; day >= 0; day--){\n    const n = day === 0 ? 2 : 2 + (day * 3) % 4;\n    for(let i = 0; i < n; i++) S.sessions.push({task: tasks[(day + i) % tasks.length], mins: 25, at: now - day * 864e5 - (n - i) * 40 * 6e4});\n  }\n  stats(); await save(); appToast('Added a week of example sessions', 'ok');\n}\n\ndocument.querySelectorAll('#modes button').forEach(b => b.addEventListener('click', () => setMode(b.dataset.m)));\n$('task').addEventListener('keydown', e => { if(e.key === 'Enter' && !S.run) toggle(); });\ndocument.addEventListener('keydown', e => {\n  if(e.key === ' ' && !/INPUT|TEXTAREA|SELECT|BUTTON/.test(document.activeElement.tagName)){ e.preventDefault(); toggle(); }\n});\n$('reset').innerHTML = appIcon('refresh') + ' Reset';\n$('plan-btn').innerHTML = appIcon('sparkle') + ' Plan this session';\n$('review-btn').innerHTML = appIcon('chart') + ' Look back';\n$('share-btn').innerHTML = appIcon('share') + ' Share';\n\n(async () => {\n  const got = await appData.get();\n  if(got && typeof got === 'object' && got.settings) S = Object.assign(JSON.parse(JSON.stringify(DEF)), got);\n  if(S.run && S.run.task) $('task').value = S.run.task;\n  fillSettings();\n  if(S.run && left() <= 0) await finish();\n  paint(); stats(); startTick();\n  if(appSurface.desktop) $('task').focus();\n  if(appSurface.desktop) appCopilot.mount({starters: ['How much did I focus this week?', 'Plan three sessions for tomorrow', 'Which task took most of my time?']});\n})();\nwindow.addEventListener('appdata', async () => { const got = await appData.get(); if(got && got.settings){ S = Object.assign(S, got); paint(); stats(); } });\n</script>\n",
 "checksum": "sha256:4b7b9f0f0f10dbd543deea8dd92b26420fa1404c8427f3c0f747f0d7214471e1",
 "signature": null
}
