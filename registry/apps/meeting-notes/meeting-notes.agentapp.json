{
 "format": "agentos-app/1",
 "manifest": {
  "format": 1,
  "name": "Meeting Notes",
  "icon": "",
  "description": "Keep each meeting's agenda, notes, decisions and action items with owners and dates. The AI writes the summary and pulls the actions out of your notes; every open action is in one list.",
  "version": "1",
  "permissions": [
   {
    "action": "app.data.read",
    "resource": "app:self/data",
    "reason": "load what you saved when the app opens",
    "required": true
   },
   {
    "action": "app.data.write",
    "resource": "app:self/data",
    "reason": "save what you add and change",
    "required": true
   },
   {
    "action": "tool.use",
    "resource": "tool:llm_generate*",
    "required": false,
    "reason": "summarise a meeting and pull the actions out of your notes"
   },
   {
    "action": "agent.invoke",
    "resource": "agent:main",
    "required": false,
    "reason": "the ✦ assistant in the corner, which can act for you inside this app"
   }
  ],
  "prerequisites": {},
  "security": {
   "scanner": "static/1",
   "scanned_at": 1795803746,
   "verdict": "pass",
   "findings": []
  },
  "author": {
   "kind": "agent",
   "name": "Bento: written with an AI agent and checked by the Bento team"
  }
 },
 "html": "<style>\n  .mn-wrap{display:grid;grid-template-columns:260px minmax(0,1fr);gap:14px;align-items:start}\n  .mn-side .item{cursor:pointer;border-radius:10px;padding:8px 10px}\n  .mn-side .item.on{background:color-mix(in srgb,var(--acc) 16%,transparent)}\n  .mn-side .title{overflow-wrap:anywhere;white-space:normal;overflow:visible;text-overflow:clip}\n  .mn-act{display:grid;grid-template-columns:auto minmax(0,1fr) 120px 140px auto;gap:6px;align-items:center;margin-bottom:6px}\n  .mn-act input[type=checkbox]{width:18px;height:18px}\n  .mn-act.done .t{text-decoration:line-through;opacity:.6}\n  .mn-act button{padding:4px 8px}\n  .mn-act svg,.mn-ic svg{width:14px;height:14px;vertical-align:-2px}\n  .mn-sum{white-space:pre-wrap;line-height:1.6}\n  .mn-dec{margin:0;padding-left:18px}\n  .mn-open .item{padding:7px 0}\n  textarea.mn-notes{min-height:180px;font:13.5px/1.6 Inter,system-ui,sans-serif}\n  @media (max-width:760px){ .mn-wrap{grid-template-columns:1fr} .mn-act{grid-template-columns:auto minmax(0,1fr) auto} .mn-act .wide{grid-column:2/3} }\n</style>\n\n<div class=\"widget-only\">\n  <h3>Open actions</h3>\n  <div class=\"stat\"><b id=\"w-open\">0</b><span>waiting</span></div>\n  <div class=\"muted\" id=\"w-next\" style=\"margin-top:6px\"></div>\n</div>\n\n<div class=\"desktop-only\">\n  <div class=\"hero\">\n    <div><h1>Meeting Notes</h1><div class=\"muted\">Agenda, notes, decisions and who does what, in one place.</div></div>\n    <button onclick=\"newMeeting()\" id=\"new-btn\"></button>\n  </div>\n\n  <div class=\"mn-wrap\">\n    <div class=\"mn-side\">\n      <div class=\"card\">\n        <input id=\"find\" placeholder=\"Search meetings\">\n        <div class=\"list\" id=\"meetings\" style=\"margin-top:8px\"></div>\n      </div>\n      <div class=\"card mn-open\">\n        <h2>Open actions <span class=\"muted\" id=\"open-count\"></span></h2>\n        <div class=\"list\" id=\"open\"></div>\n      </div>\n    </div>\n\n    <div id=\"main\"></div>\n  </div>\n</div>\n\n<script>\nlet S = {meetings: [], open: ''}, saveT = 0;\nconst $ = id => document.getElementById(id);\nconst esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst uid = () => Math.random().toString(36).slice(2, 10);\nconst ymd = d => { d = new Date(d); return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };\nconst TODAY = () => ymd(new Date());\nconst cur = () => S.meetings.find(m => m.id === S.open);\n\nasync function save(){ await appData.set(S); }\nfunction saveSoon(){ clearTimeout(saveT); saveT = setTimeout(save, 600); }\n\nfunction paintSide(){\n  const q = ($('find').value || '').toLowerCase();\n  const ms = S.meetings.filter(m => !q || (m.title + ' ' + m.people + ' ' + m.notes).toLowerCase().includes(q))\n                       .sort((a, b) => (b.date || '').localeCompare(a.date || '') || b.at - a.at);\n  $('meetings').innerHTML = ms.length ? ms.map(m => `<div class=\"item ${m.id === S.open ? 'on' : ''}\" onclick=\"openM('${m.id}')\">\n      <div class=\"grow\"><div class=\"title\">${esc(m.title || 'Untitled meeting')}</div>\n      <div class=\"muted\">${m.date ? esc(appFmt.date(new Date(m.date + 'T12:00').getTime())) : ''}${m.people ? ' · ' + esc(m.people) : ''}</div></div></div>`).join('')\n    : `<div class=\"empty\">${q ? 'No meeting matches that.' : '<b>No meetings yet</b>Start one before the call and take notes as you go.'}</div>`;\n  // every open action across meetings\n  const open = [];\n  S.meetings.forEach(m => (m.actions || []).forEach(a => { if(!a.done) open.push({...a, mid: m.id, mt: m.title}); }));\n  open.sort((a, b) => (a.due || '9999').localeCompare(b.due || '9999'));\n  $('open-count').textContent = open.length || '';\n  $('open').innerHTML = open.length ? open.slice(0, 12).map(a => `<div class=\"item\"><div class=\"grow\">\n      <div class=\"title\">${esc(a.text)}</div>\n      <div class=\"muted\">${esc(a.who || 'nobody yet')}${a.due ? ' · ' + (a.due < TODAY() ? '<span class=\"err\">' : '<span>') + esc(appFmt.date(new Date(a.due + 'T12:00').getTime())) + '</span>' : ''} · <a href=\"#\" onclick=\"openM('${a.mid}');return false\">${esc(a.mt || 'meeting')}</a></div></div>\n      <button class=\"ghost sm\" title=\"Mark done\" onclick=\"doneAct('${a.mid}','${a.id}')\">${appIcon('check')}</button></div>`).join('')\n    : '<div class=\"empty\">No open actions. Nice.</div>';\n  $('w-open').textContent = open.length;\n  $('w-next').textContent = open.length ? 'Next: ' + open[0].text + (open[0].who ? ' (' + open[0].who + ')' : '') : 'Nothing waiting.';\n}\n\nfunction paintMain(){\n  const m = cur(), box = $('main');\n  if(!m){\n    box.innerHTML = `<div class=\"card\"><div class=\"empty\"><b>Pick a meeting, or start a new one</b>\n      Write the agenda before the call, notes during it, and let the AI turn them into a summary and actions after.\n      <div class=\"row\" style=\"margin-top:8px;justify-content:center\"><button class=\"sm\" onclick=\"newMeeting()\">New meeting</button>\n      <button class=\"ghost sm\" onclick=\"example()\">Try it with an example</button></div></div></div>`;\n    return;\n  }\n  box.innerHTML = `<div class=\"card accent\">\n      <div class=\"grid2\"><div><label for=\"m-title\">Meeting</label><input id=\"m-title\" maxlength=\"120\" value=\"${esc(m.title)}\" placeholder=\"e.g. Weekly product sync\"></div>\n        <div><label for=\"m-date\">Date</label><input id=\"m-date\" type=\"date\" value=\"${esc(m.date || '')}\"></div></div>\n      <label for=\"m-people\">Who was there</label><input id=\"m-people\" maxlength=\"300\" value=\"${esc(m.people || '')}\" placeholder=\"Names, separated by commas\">\n      <label for=\"m-agenda\">Agenda</label><textarea id=\"m-agenda\" rows=\"3\" placeholder=\"One topic a line\">${esc(m.agenda || '')}</textarea>\n      <label for=\"m-notes\">Notes</label><textarea id=\"m-notes\" class=\"mn-notes\" placeholder=\"What was said. Rough is fine.\">${esc(m.notes || '')}</textarea>\n      <div class=\"row\" style=\"margin-top:10px\">\n        <button onclick=\"summarise()\" id=\"sum-btn\">${appIcon('sparkle')} Summarise</button>\n        <button class=\"ghost\" onclick=\"pullActions()\" id=\"pull-btn\">${appIcon('check')} Pull out actions</button>\n        <button class=\"ghost\" onclick=\"shareM()\">${appIcon('share')} Share the minutes</button>\n        <button class=\"ghost danger\" onclick=\"removeM()\">${appIcon('trash')} Delete</button>\n      </div>\n    </div>\n    <div class=\"card\" id=\"sum-card\" ${m.summary ? '' : 'hidden'}><h2>Summary</h2><div class=\"mn-sum\" id=\"sum\">${esc(m.summary || '')}</div></div>\n    <div class=\"card\"><div class=\"spread\"><h2>Decisions</h2></div>\n      ${(m.decisions || []).length ? `<ul class=\"mn-dec\">${m.decisions.map((d, i) => `<li>${esc(d)} <a href=\"#\" class=\"muted\" onclick=\"dropDecision(${i});return false\">remove</a></li>`).join('')}</ul>` : '<div class=\"muted\">None yet. Summarise picks them out of your notes, or add one.</div>'}\n      <div class=\"row\" style=\"margin-top:8px\"><input id=\"dec-new\" placeholder=\"Add a decision\" maxlength=\"200\"><button class=\"ghost sm\" onclick=\"addDecision()\">Add</button></div></div>\n    <div class=\"card\"><h2>Actions</h2><div id=\"acts\"></div>\n      <div class=\"row\" style=\"margin-top:8px\"><input id=\"act-new\" placeholder=\"Add an action, e.g. Ana: send the deck by Friday\" maxlength=\"200\"><button class=\"ghost sm\" onclick=\"addAct()\">Add</button></div></div>`;\n  paintActs();\n  [['m-title','title'],['m-date','date'],['m-people','people'],['m-agenda','agenda'],['m-notes','notes']].forEach(([id, k]) =>\n    $(id).addEventListener('input', () => { m[k] = $(id).value; if(k !== 'notes' && k !== 'agenda') paintSide(); saveSoon(); }));\n  $('act-new').addEventListener('keydown', e => { if(e.key === 'Enter') addAct(); });\n  $('dec-new').addEventListener('keydown', e => { if(e.key === 'Enter') addDecision(); });\n}\n\nfunction paintActs(){\n  const m = cur(); if(!m) return;\n  const acts = m.actions || [];\n  $('acts').innerHTML = acts.length ? acts.map(a => `<div class=\"mn-act ${a.done ? 'done' : ''}\">\n      <input type=\"checkbox\" ${a.done ? 'checked' : ''} onchange=\"toggleAct('${a.id}',this.checked)\" aria-label=\"done\">\n      <input class=\"t\" value=\"${esc(a.text)}\" onchange=\"editAct('${a.id}','text',this.value)\" maxlength=\"200\">\n      <input class=\"wide\" value=\"${esc(a.who || '')}\" placeholder=\"Who\" onchange=\"editAct('${a.id}','who',this.value)\" maxlength=\"60\">\n      <input class=\"wide\" type=\"date\" value=\"${esc(a.due || '')}\" onchange=\"editAct('${a.id}','due',this.value)\">\n      <button class=\"ghost sm\" title=\"Remove\" onclick=\"dropAct('${a.id}')\">${appIcon('x')}</button></div>`).join('')\n    : '<div class=\"empty\">No actions yet. Add one, or press Pull out actions after the meeting.</div>';\n}\n\nfunction openM(id){ S.open = id; paintSide(); paintMain(); save(); }\nasync function newMeeting(){\n  const m = {id: uid(), title: '', date: TODAY(), people: '', agenda: '', notes: '', decisions: [], actions: [], at: Date.now()};\n  S.meetings.push(m); S.open = m.id; paintSide(); paintMain(); $('m-title').focus(); await save();\n}\nasync function removeM(){\n  const m = cur(); if(!m) return;\n  if(!(await appConfirm('Delete \"' + (m.title || 'this meeting') + '\" and its actions?', {danger: true, ok: 'Delete'}))) return;\n  S.meetings = S.meetings.filter(x => x !== m); S.open = ''; paintSide(); paintMain(); await save();\n}\n\nfunction parseAct(line){\n  // \"Ana: send the deck by 2026-12-04\" or \"send the deck (Ana)\"\n  let who = '', text = line.trim(), due = '';\n  const m1 = text.match(/^([A-Z][\\w .'-]{0,30}):\\s*(.+)$/); if(m1){ who = m1[1].trim(); text = m1[2]; }\n  const m2 = text.match(/\\(([^)]{1,30})\\)\\s*$/); if(!who && m2){ who = m2[1].trim(); text = text.slice(0, m2.index).trim(); }\n  const m3 = text.match(/\\b(\\d{4}-\\d{2}-\\d{2})\\b/); if(m3) due = m3[1];\n  return {id: uid(), text, who, due, done: false};\n}\nasync function addAct(){ const v = $('act-new').value.trim(); if(!v) return; const m = cur();\n  (m.actions = m.actions || []).push(parseAct(v)); $('act-new').value = ''; paintActs(); paintSide(); await save(); $('act-new').focus(); }\nasync function toggleAct(id, v){ const a = (cur().actions || []).find(x => x.id === id); if(!a) return; a.done = v; paintActs(); paintSide(); await save();\n  if(v && (cur().actions || []).every(x => x.done)) appToast('Every action from this meeting is done', 'ok'); }\nasync function editAct(id, k, v){ const a = (cur().actions || []).find(x => x.id === id); if(!a) return; a[k] = v.trim(); paintSide(); await save(); }\nasync function dropAct(id){ const m = cur(); m.actions = (m.actions || []).filter(x => x.id !== id); paintActs(); paintSide(); await save(); }\nasync function doneAct(mid, id){ const m = S.meetings.find(x => x.id === mid); const a = m && (m.actions || []).find(x => x.id === id); if(!a) return;\n  a.done = true; paintSide(); if(S.open === mid) paintActs(); await save(); appToast('Done: ' + a.text, 'ok'); }\nasync function addDecision(){ const v = $('dec-new').value.trim(); if(!v) return; const m = cur(); (m.decisions = m.decisions || []).push(v); paintMain(); await save(); }\nasync function dropDecision(i){ const m = cur(); m.decisions.splice(i, 1); paintMain(); await save(); }\n\nfunction context(m){\n  return `Meeting: ${m.title || 'untitled'} on ${m.date || 'unknown date'}\\nPeople: ${m.people || 'not listed'}\\nAgenda:\\n${m.agenda || '(none)'}\\nNotes:\\n${m.notes || '(none)'}`;\n}\n\nasync function summarise(){\n  const m = cur(); if(!m) return;\n  if(!(m.notes || '').trim()){ appToast('Write some notes first', 'info'); $('m-notes').focus(); return; }\n  $('sum-card').hidden = false; const box = $('sum'); box.innerHTML = '<span class=\"spin\"></span>';\n  const out = await appLLM.stream(context(m) + '\\n\\nWrite the minutes: a two-sentence summary, then \"Decisions:\" as bullets, ' +\n    'then \"Open questions:\" as bullets (or \"none\"). Only what the notes say; do not invent.',\n    {system: 'You write clear, short meeting minutes.', onDelta: (_, all) => { box.textContent = all; }});\n  if(out.startsWith('[error]')){ box.innerHTML = '<span class=\"err\">The AI could not answer: ' + esc(out.slice(8)) + '</span>'; return; }\n  m.summary = out.trim();\n  const dec = out.split(/decisions:/i)[1];\n  if(dec){\n    const picked = dec.split(/open questions:/i)[0].split('\\n').map(l => l.replace(/^\\s*[-*•]\\s*/, '').trim()).filter(l => l && !/^none\\.?$/i.test(l));\n    const have = new Set((m.decisions || []).map(d => d.toLowerCase()));\n    m.decisions = (m.decisions || []).concat(picked.filter(d => !have.has(d.toLowerCase())).slice(0, 10));\n  }\n  await save(); paintMain(); appToast('Summary written', 'ok');\n}\n\nasync function pullActions(){\n  const m = cur(); if(!m) return;\n  if(!(m.notes || '').trim()){ appToast('Write some notes first', 'info'); return; }\n  const btn = $('pull-btn'); btn.disabled = true; btn.innerHTML = '<span class=\"spin\"></span> Reading the notes';\n  const out = await appLLM(context(m) + '\\nToday is ' + TODAY() + '.',\n    'List the action items in the notes as JSON only: [{\"text\": what, \"who\": a name from the notes or \"\", \"due\": \"YYYY-MM-DD\" or \"\"}]. ' +\n    'Only actions someone agreed to do. [] if there are none.');\n  btn.disabled = false; btn.innerHTML = appIcon('check') + ' Pull out actions';\n  if(out.startsWith('[error]')){ appToast('The AI is not available right now', 'err'); return; }\n  let got = null; const j = out.match(/\\[[\\s\\S]*\\]/); try{ got = j ? JSON.parse(j[0]) : null; }catch(e){}\n  if(!Array.isArray(got)){ appToast('The AI did not give a list this time', 'err'); return; }\n  const have = new Set((m.actions || []).map(a => a.text.toLowerCase()));\n  const add = got.filter(a => a && typeof a.text === 'string' && a.text.trim() && !have.has(a.text.trim().toLowerCase())).slice(0, 15)\n    .map(a => ({id: uid(), text: a.text.trim().slice(0, 200), who: String(a.who || '').slice(0, 60),\n                due: /^\\d{4}-\\d{2}-\\d{2}$/.test(a.due || '') ? a.due : '', done: false}));\n  m.actions = (m.actions || []).concat(add);\n  paintActs(); paintSide(); await save();\n  appToast(add.length ? 'Added ' + add.length + ' action' + (add.length === 1 ? '' : 's') : 'No new actions found', add.length ? 'ok' : 'info');\n}\n\nfunction shareM(){\n  const m = cur(); if(!m) return;\n  const acts = (m.actions || []).map(a => `• ${a.done ? '[done] ' : ''}${a.text}${a.who ? ' (' + a.who + ')' : ''}${a.due ? ', by ' + a.due : ''}`);\n  appShare({title: (m.title || 'Meeting') + (m.date ? ', ' + m.date : ''),\n            text: [m.people ? 'With ' + m.people : '', m.summary || '', (m.decisions || []).length ? 'Decisions:\\n' + m.decisions.map(d => '• ' + d).join('\\n') : '',\n                   acts.length ? 'Actions:\\n' + acts.join('\\n') : ''].filter(Boolean).join('\\n\\n')});\n}\n\nasync function example(){\n  const d = n => { const x = new Date(); x.setDate(x.getDate() + n); return ymd(x); };\n  const m = {id: uid(), title: 'Launch planning', date: TODAY(), people: 'Ana, Ben, Chloe', at: Date.now(),\n    agenda: 'Launch date\\nPricing page\\nSupport cover for launch week',\n    notes: 'Ana proposed launching on the 14th, everyone agreed. Pricing page needs the new annual plan; Ben will update the copy by ' + d(3) + '.\\n' +\n      'Chloe raised that support is thin that week. We decided to add one contractor for two weeks. Chloe to find someone by ' + d(5) + '.\\n' +\n      'Open: do we email existing customers before or after the launch post? Ana to draft both versions.',\n    decisions: [], actions: []};\n  S.meetings.push(m); S.open = m.id; paintSide(); paintMain(); await save(); appToast('Here is an example meeting', 'ok');\n}\n\n$('new-btn').innerHTML = appIcon('plus') + ' New meeting';\n$('find').addEventListener('input', paintSide);\ndocument.addEventListener('keydown', e => { if((e.metaKey || e.ctrlKey) && e.key === 'Enter' && cur()) summarise(); });\n\n(async () => {\n  const got = await appData.get();\n  if(got && Array.isArray(got.meetings)) S = Object.assign({open: ''}, got);\n  if(S.open && !cur()) S.open = '';\n  paintSide(); paintMain();\n  if(appSurface.desktop) appCopilot.mount({starters: ['What do I owe people this week?', 'Summarise my last three meetings', 'Who has the most open actions?']});\n})();\nwindow.addEventListener('appdata', async () => { const got = await appData.get(); if(got && Array.isArray(got.meetings)){ S = Object.assign({open: S.open}, got); paintSide(); paintMain(); } });\n</script>\n",
 "checksum": "sha256:db19851a48edd9ac29b6e2f20f188d8d113ea74b4be986481925c38ec2f6970a",
 "signature": null
}
