{
 "format": "agentos-app/1",
 "manifest": {
  "format": 1,
  "name": "Habit Tracker",
  "icon": "",
  "description": "Tick off daily habits, keep your streaks and see the last four weeks at a glance. The AI coach reads your history and suggests one small change.",
  "version": "1",
  "permissions": [
   {
    "action": "app.data.read",
