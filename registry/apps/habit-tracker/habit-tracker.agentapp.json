 },
 "html": "<style>\n  .ht-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px 0;border-top:1px solid var(--ln)}\n  .ht-row:first-child{border-top:none}\n  .ht-name{font-weight:650;overflow-wrap:anywhere}\n  .ht-days{display:grid;grid-template-columns:repeat(7,30px);gap:5px}\n  .ht-day{width:30px;height:30px;border-radius:9px;border:1px solid var(--ln2);background:transparent;padding:0;display:grid;place-items:center;\n    color:var(--mut);font-size:11px;cursor:pointer;box-shadow:none}\n  .ht-day.on{background:var(--acc);border-color:var(--acc);color:var(--on-acc)}\n  .ht-day.today{outline:2px solid color-mix(in srgb,var(--acc) 55%,transparent);outline-offset:1px}\n  .ht-day svg{width:15px;height:15px}\n  .ht-head{display:grid;grid-template-columns:repeat(7,30px);gap:5px;font-size:10.5px;color:var(--mut);text-align:center}\n  .ht-meta{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:var(--mut);margin-top:2px}\n  .ht-meta svg{width:13px;height:13px;vertical-align:-2px}\n  .ht-acts button{padding:4px 8px}\n  .ht-acts svg{width:14px;height:14px}\n  .ht-grid{display:grid;grid-template-columns:repeat(28,1fr);gap:3px}\n  .ht-cell{aspect-ratio:1;border-radius:3px;background:color-mix(in srgb,var(--tx) 7%,transparent)}\n  .ht-cell.l1{background:color-mix(in srgb,var(--acc) 35%,transparent)}\n  .ht-cell.l2{background:color-mix(in srgb,var(--acc) 65%,transparent)}\n  .ht-cell.l3{background:var(--acc)}\n  .ht-coach{white-space:pre-wrap;line-height:1.6}\n  .ht-w .ht-day{width:26px;height:26px}\n  .ht-w .item{padding:6px 0}\n  @media (max-width:560px){ .ht-row{grid-template-columns:1fr} .ht-days,.ht-head{grid-template-columns:repeat(7,1fr)} .ht-day{width:100%;height:34px} }\n</style>\n\n<div class=\"widget-only\">\n  <div class=\"ht-w\">\n    <h3>Habits today</h3>\n    <div class=\"stat\"><b id=\"w-count\">0 of 0</b><span>done</span></div>\n    <div class=\"progress\" style=\"margin:6px 0\"><i id=\"w-bar\" style=\"width:0%\"></i></div>\n    <div id=\"w-next\" class=\"muted\"></div>\n  </div>\n</div>\n\n<div class=\"desktop-only\">\n  <div class=\"hero\">\n    <div><h1>Habit Tracker</h1><div class=\"muted\">Small things, every day. Tick them off and keep the streak going.</div></div>\n    <button onclick=\"showAdd()\" id=\"add-btn\"></button>\n  </div>\n\n  <div class=\"cols\">\n    <div class=\"stat\"><b id=\"k-today\">0/0</b><span>done today</span></div>\n    <div class=\"stat\"><b id=\"k-best\">0</b><span>longest streak now</span></div>\n    <div class=\"stat\"><b id=\"k-rate\">0%</b><span>of the last 28 days</span></div>\n  </div>\n\n  <div class=\"card\" id=\"add-card\" hidden>\n    <h2>A new habit</h2>\n    <div class=\"grid2\">\n      <div><label for=\"h-name\">What is it?</label><input id=\"h-name\" maxlength=\"60\" placeholder=\"e.g. Read 10 pages\"></div>\n      <div><label for=\"h-goal\">Days a week</label>\n        <select id=\"h-goal\"><option value=\"7\">Every day</option><option value=\"6\">6 days</option><option value=\"5\">5 days</option>\n          <option value=\"4\">4 days</option><option value=\"3\">3 days</option><option value=\"2\">2 days</option><option value=\"1\">Once a week</option></select></div>\n    </div>\n    <div class=\"row\" style=\"margin-top:10px\"><button onclick=\"addHabit()\">Add the habit</button><button class=\"ghost\" onclick=\"hideAdd()\">Cancel</button></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"spread\"><h2>This week</h2><span class=\"muted\" id=\"week-label\"></span></div>\n    <div class=\"ht-row\" style=\"padding-top:0\"><span></span><div class=\"ht-head\" id=\"head\"></div></div>\n    <div id=\"list\"></div>\n  </div>\n\n  <div class=\"grid2\">\n    <div class=\"card\">\n      <h2>The last four weeks</h2>\n      <div class=\"ht-grid\" id=\"grid\"></div>\n      <p class=\"muted\" style=\"margin:8px 0 0\">Each square is a day; darker means more of your habits were done.</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"spread\"><h2>Your coach</h2>\n        <span class=\"row\"><button class=\"ghost sm\" onclick=\"coach()\" id=\"coach-btn\"></button>\n        <button class=\"ghost sm\" onclick=\"share()\" id=\"share-btn\"></button></span></div>\n      <div id=\"coach\" class=\"ht-coach muted\">Ask the coach once you have a few days of ticks. It reads your history and suggests one small change.</div>\n    </div>\n  </div>\n</div>\n\n<script>\nlet S = {habits: []};\nconst $ = id => document.getElementById(id);\nconst esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst ymd = d => { d = new Date(d); return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };\nconst dayAgo = n => { const d = new Date(); d.setHours(12,0,0,0); d.setDate(d.getDate() - n); return d; };\nconst TODAY = () => ymd(new Date());\nconst uid = () => Math.random().toString(36).slice(2, 10);\n\nasync function save(){ await appData.set(S); }\n\nfunction streak(h){\n  const done = new Set(h.done || []);\n  let n = 0, i = done.has(TODAY()) ? 0 : 1;\n  while(done.has(ymd(dayAgo(i)))){ n++; i++; }\n  return n;\n}\nfunction best(h){\n  const days = [...new Set(h.done || [])].sort();\n  let b = 0, run = 0, prev = null;\n  days.forEach(k => { const t = new Date(k + 'T12:00'); run = prev && (t - prev) / 864e5 < 1.5 ? run + 1 : 1; prev = t; b = Math.max(b, run); });\n  return b;\n}\nfunction thisWeek(h){ const done = new Set(h.done || []); let n = 0; for(let i = 0; i < 7; i++) if(done.has(ymd(dayAgo(i)))) n++; return n; }\n\nfunction paint(){\n  const days = [6,5,4,3,2,1,0].map(dayAgo);\n  $('head').innerHTML = days.map(d => `<span>${esc(d.toLocaleDateString(undefined, {weekday:'narrow'}))}</span>`).join('');\n  $('week-label').textContent = days[0].toLocaleDateString(undefined, {month:'short', day:'numeric'}) + ' to today';\n  const t = TODAY(), list = $('list');\n  if(!S.habits.length){\n    list.innerHTML = `<div class=\"empty\"><b>No habits yet</b>Add the first small thing you want to do every day.\n      <div class=\"row\" style=\"margin-top:8px;justify-content:center\"><button class=\"sm\" onclick=\"showAdd()\">Add a habit</button>\n      <button class=\"ghost sm\" onclick=\"example()\">Try it with an example</button></div></div>`;\n  }else{\n    list.innerHTML = S.habits.map(h => {\n      const done = new Set(h.done || []), s = streak(h), wk = thisWeek(h);\n      return `<div class=\"ht-row\">\n        <div><div class=\"ht-name\">${esc(h.name)}</div>\n          <div class=\"ht-meta\"><span>${appIcon('fire')} ${s} day${s === 1 ? '' : 's'}</span>\n            <span>${appIcon('target')} ${wk >= h.goal ? 'weekly goal met (' + wk + ' days)' : wk + ' of ' + h.goal + ' days this week'}</span>\n            <span class=\"ht-acts\"><button class=\"ghost sm\" title=\"Rename\" onclick=\"rename('${h.id}')\">${appIcon('edit')}</button>\n            <button class=\"ghost sm\" title=\"Delete\" onclick=\"remove('${h.id}')\">${appIcon('trash')}</button></span></div></div>\n        <div class=\"ht-days\">${days.map(d => { const k = ymd(d), on = done.has(k);\n          return `<button class=\"ht-day ${on ? 'on' : ''} ${k === t ? 'today' : ''}\" title=\"${esc(d.toDateString())}\"\n            aria-pressed=\"${on}\" aria-label=\"${esc(h.name)} on ${esc(d.toDateString())}\" onclick=\"tick('${h.id}','${k}')\">${on ? appIcon('check') : d.getDate()}</button>`; }).join('')}</div>\n      </div>`; }).join('');\n  }\n  // numbers\n  const doneToday = S.habits.filter(h => (h.done || []).includes(t)).length;\n  $('k-today').textContent = doneToday + '/' + S.habits.length;\n  $('k-best').textContent = S.habits.reduce((a, h) => Math.max(a, streak(h)), 0);\n  let have = 0, could = 0;\n  for(let i = 0; i < 28; i++){ const k = ymd(dayAgo(i)); S.habits.forEach(h => { could++; if((h.done || []).includes(k)) have++; }); }\n  $('k-rate').textContent = could ? appFmt.pct(have / could) : '0%';\n  // four weeks\n  const cells = [];\n  for(let i = 27; i >= 0; i--){ const k = ymd(dayAgo(i)); const n = S.habits.filter(h => (h.done || []).includes(k)).length;\n    const f = S.habits.length ? n / S.habits.length : 0;\n    cells.push(`<i class=\"ht-cell ${f >= .99 ? 'l3' : f >= .5 ? 'l2' : f > 0 ? 'l1' : ''}\" title=\"${k}: ${n} of ${S.habits.length}\"></i>`); }\n  $('grid').innerHTML = cells.join('');\n  // widget\n  $('w-count').textContent = doneToday + ' of ' + S.habits.length;\n  $('w-bar').style.width = (S.habits.length ? Math.round(doneToday / S.habits.length * 100) : 0) + '%';\n  const next = S.habits.find(h => !(h.done || []).includes(t));\n  $('w-next').innerHTML = !S.habits.length ? 'Add a habit to start.' : next\n    ? `Next: <b>${esc(next.name)}</b> <button class=\"sm\" onclick=\"tick('${next.id}','${t}')\">Done</button>` : 'All done today.';\n}\n\nasync function tick(id, day){\n  const h = S.habits.find(x => x.id === id); if(!h) return;\n  h.done = h.done || [];\n  const t = TODAY(), allBefore = S.habits.length && S.habits.every(x => (x.done || []).includes(t));\n  if(h.done.includes(day)) h.done = h.done.filter(k => k !== day);\n  else{\n    h.done.push(day);\n    const s = streak(h);\n    if(day === t && [7, 30, 100].includes(s)){ appCelebrate(); appToast(s + ' days in a row of ' + h.name, 'ok'); }\n  }\n  h.done = h.done.filter(k => k >= ymd(dayAgo(400)));\n  const allNow = S.habits.every(x => (x.done || []).includes(t));\n  if(!allBefore && allNow){ appCelebrate(); appToast('Everything done today', 'ok'); }\n  paint(); await save();\n}\n\nfunction showAdd(){ $('add-card').hidden = false; $('h-name').focus(); }\nfunction hideAdd(){ $('add-card').hidden = true; $('h-name').value = ''; }\nasync function addHabit(){\n  const name = $('h-name').value.trim();\n  if(!name){ $('h-name').focus(); return; }\n  if(S.habits.some(h => h.name.toLowerCase() === name.toLowerCase())){ appToast('You already track that one', 'info'); return; }\n  S.habits.push({id: uid(), name, goal: Number($('h-goal').value) || 7, done: [], created: Date.now()});\n  hideAdd(); paint(); await save(); appToast('Added ' + name, 'ok');\n}\nasync function rename(id){\n  const h = S.habits.find(x => x.id === id); if(!h) return;\n  const row = [...document.querySelectorAll('.ht-name')].find(el => el.textContent === h.name);\n  if(!row) return;\n  const inp = document.createElement('input'); inp.value = h.name; inp.maxLength = 60;\n  row.replaceWith(inp); inp.focus(); inp.select();\n  const done = async keep => { if(keep && inp.value.trim()) h.name = inp.value.trim(); paint(); await save(); };\n  inp.addEventListener('keydown', e => { if(e.key === 'Enter') done(true); if(e.key === 'Escape') done(false); });\n  inp.addEventListener('blur', () => done(true));\n}\nasync function remove(id){\n  const h = S.habits.find(x => x.id === id); if(!h) return;\n  if(!(await appConfirm('Delete \"' + h.name + '\" and its history?', {danger: true, ok: 'Delete'}))) return;\n  S.habits = S.habits.filter(x => x.id !== id); paint(); await save(); appToast('Deleted', 'ok');\n}\n\nasync function coach(){\n  const box = $('coach');\n  if(!S.habits.length){ box.textContent = 'Add a habit first, then come back after a few days.'; return; }\n  box.classList.remove('muted'); box.innerHTML = '<span class=\"spin\"></span>';\n  const lines = S.habits.map(h => { const d = new Set(h.done || []);\n    return `${h.name} (goal ${h.goal}/week): ` + [...Array(28)].map((_, i) => d.has(ymd(dayAgo(27 - i))) ? 'x' : '.').join('') +\n      ` streak ${streak(h)}`; }).join('\\n');\n  const out = await appLLM.stream('My habits over the last 28 days, oldest first (x = done, . = missed):\\n' + lines +\n    '\\n\\nAs my coach: one line on what is going well, one on the habit that slips most and on which days, ' +\n    'and ONE small, specific change for next week. Warm and brief, no headings.',\n    {system: 'You are a kind, practical habit coach. Never scold.', onDelta: (_, all) => { box.textContent = all; }});\n  if(out.startsWith('[error]')) box.innerHTML = '<span class=\"err\">The coach could not answer: ' + esc(out.slice(8)) + '</span>';\n}\n\nfunction share(){\n  if(!S.habits.length){ appToast('Nothing to share yet', 'info'); return; }\n  appShare({title: 'My habits this week', text: S.habits.map(h => `• ${h.name}: ${thisWeek(h)} of ${h.goal} days, ${streak(h)} in a row`).join('\\n')});\n}\n\nasync function example(){\n  const names = [['Read 10 pages', 7, .85], ['Walk 20 minutes', 5, .7], ['No phone after 10pm', 7, .55], ['Write three lines in a journal', 6, .75]];\n  S.habits = names.map(([name, goal, p], j) => { const done = [];\n    for(let i = 1; i < 28; i++) if(((i * 7 + j * 13) % 100) / 100 < p) done.push(ymd(dayAgo(i)));\n    return {id: uid(), name, goal, done, created: Date.now()}; });\n  paint(); await save(); appToast('Added four example habits', 'ok');\n}\n\n$('add-btn').innerHTML = appIcon('plus') + ' Add a habit';\n$('coach-btn').innerHTML = appIcon('sparkle') + ' Ask the coach';\n$('share-btn').innerHTML = appIcon('share') + ' Share';\n$('h-name').addEventListener('keydown', e => { if(e.key === 'Enter') addHabit(); if(e.key === 'Escape') hideAdd(); });\n\n(async () => {\n  const got = await appData.get();\n  if(got && Array.isArray(got.habits)) S = got;\n  paint();\n  if(appSurface.desktop) appCopilot.mount({starters: ['Which habit am I missing most?', 'Add a habit to drink water', 'How did I do this week?']});\n})();\nwindow.addEventListener('appdata', async () => { const got = await appData.get(); if(got && Array.isArray(got.habits)){ S = got; paint(); } });\n// the date moves at midnight while the app stays open\nsetInterval(() => { if(paint.day !== TODAY()){ paint.day = TODAY(); paint(); } }, 60000);\npaint.day = TODAY();\n</script>\n",
 "checksum": "sha256:c327a03babbd71f6f8be7ca1f01de9abdf319374e276139b64434ae27167f607",
 "signature": null
}
