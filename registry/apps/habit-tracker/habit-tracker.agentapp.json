   },
   {
    "action": "app.data.write",
    "resource": "app:self/data",
    "reason": "save what you add and change",
    "required": true
   },
   {
    "action": "tool.use",
    "resource": "tool:llm_generate*",
    "required": false,
    "reason": "the coach, which reads your habit history"
   },
   {
    "action": "agent.invoke",
    "resource": "agent:main",
    "required": false,
    "reason": "the ✦ assistant in the corner, which can act for you inside this app"
   }
  ],
  "prerequisites": {},
